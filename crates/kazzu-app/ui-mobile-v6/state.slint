import { AppBridge } from "app-bridge.slint";
import { Design, Track, Scheme } from "data.slint";

export enum Screen { home, explore, library, search, replay, settings, settings-page, appearance }
export enum Sheet { none, queue, more, sleep, outputs, playlist-create, playlist-rename, playlist-delete, playlist-add, metadata }

struct Route { screen: Screen, page: int }

export global UI {
    in-out property <Screen> screen: Screen.home;
    in-out property <int> page;
    private property <[Route]> history: [];
    in-out property <bool> player-open;
    in-out property <bool> mini-hidden;
    in-out property <Sheet> sheet: Sheet.none;
    in-out property <bool> lyrics;
    out property <int> vinyl-mode: AppBridge.vinyl;
    out property <int> effects: AppBridge.effects;
    out property <bool> rounded: AppBridge.rounded;
    out property <bool> reduced-glass: AppBridge.reduce-transparency;
    out property <Track> track: AppBridge.now;
    out property <float> progress: AppBridge.progress;
    out property <bool> playing: AppBridge.playing;
    out property <bool> shuffle: AppBridge.shuffle;
    out property <bool> repeat: AppBridge.repeat;
    out property <float> volume: AppBridge.volume;
    private property <float> last-volume: 0.7;
    out property <bool> liked: AppBridge.liked;
    in-out property <int> replay-period: 4;
    in-out property <int> artist-page;
    in-out property <int> suggest-page;
    in-out property <int> discovery-index;
    in-out property <int> placed-record: -1;
    in-out property <int> pending-record: -1;
    in-out property <int> record-phase;
    in-out property <float> spin;
    in-out property <float> platter-spin;
    in-out property <int> search-source;
    in-out property <int> home-feed;
    in-out property <string> playlist-name;
    in-out property <string> metadata-id;
    in-out property <string> metadata-title;
    in-out property <string> metadata-artist;
    in-out property <string> metadata-album;
    in-out property <string> metadata-genre;
    in-out property <string> query;
    in-out property <string> settings-query;
    in-out property <string> toast-text;
    in-out property <string> toast-action;
    in-out property <int> toast-ms;
    in-out property <[bool]> toggles: [true, true, true, true, true, true, true, true, true, true, false, true, true, true, true];
    in-out property <[int]> radios: [0, 0, 0, 2, 1, 0];
    out property <[float]> glass: AppBridge.glass;
    out property <bool> dark: AppBridge.dark;
    out property <bool> motion: AppBridge.app-visible && !AppBridge.reduce-motion && root.effects > 0;
    out property <bool> battery: root.effects == 0;
    private property <Scheme> base: Design.schemes[(root.dark ? 0 : 9) + 8];
    out property <Scheme> palette: {
        bg: root.base.bg, player: root.base.player, card: root.base.card,
        high: root.base.high, ink: root.base.ink, muted: root.base.muted,
        outline: root.base.outline, accent: root.dark ? AppBridge.dark-accent : AppBridge.light-accent,
        on-accent: root.dark ? AppBridge.dark-ink : AppBridge.light-ink,
        secondary: root.base.secondary, selected: root.base.selected
    };
    out property <length> card-radius: root.rounded ? 28px : 18px;
    out property <length> tile-radius: root.rounded ? 20px : 14px;

    public function navigate(target: Screen, target-page: int) {
        if (root.screen != target || (target == Screen.settings-page && root.page != target-page)) {
            root.history.push({ screen: root.screen, page: root.page });
            root.screen = target;
            root.page = target-page;
        }
    }

    public function back() {
        if (root.sheet != Sheet.none) {
            root.sheet = Sheet.none;
        } else if (root.player-open) {
            root.player-open = false;
        } else if (AppBridge.detail-open) {
            AppBridge.close-detail();
        } else if (root.history.length > 0) {
            root.page = root.history[root.history.length - 1].page;
            root.screen = root.history[root.history.length - 1].screen;
            root.history.remove(root.history.length - 1);
        } else {
            root.screen = Screen.home;
        }
    }

    public function play(id: string) {
        if (!id.is-empty) {
            root.mini-hidden = false;
            AppBridge.play-track(id);
        }
    }

    public function next() { AppBridge.next(); }
    public function previous() { AppBridge.previous(); }

    public function edit-tags(track: Track) {
        root.metadata-id = track.id;
        root.metadata-title = track.title;
        root.metadata-artist = track.artist;
        root.metadata-album = track.album;
        root.metadata-genre = "";
        root.sheet = Sheet.metadata;
    }

    public function mute() {
        if (root.volume > 0) {
            root.last-volume = root.volume;
            AppBridge.set-volume(0);
        } else { AppBridge.set-volume(root.last-volume); }
    }

    public function toast(message: string) {
        root.toast-text = message;
        root.toast-action = "";
        root.toast-ms = 2200;
    }

    public function soon() { root.toast("Em breve nesta versão"); }

    public function setting-action(action: string, target: int) {
        if (target == -2) { root.navigate(Screen.appearance, 0); }
        else if (target >= 0) { root.navigate(Screen.settings-page, target); }
        else { AppBridge.setting(action, 0); }
    }

    public function toggle(index: int) {
        if (index == 0) { AppBridge.setting("cover", AppBridge.cover-theme ? 0 : 1); }
        else if (index == 1) { AppBridge.setting("dark", root.dark ? 0 : 1); }
        else if (index == 3) { AppBridge.setting("motion", root.motion ? 0 : 1); }
        else if (index == 2) { AppBridge.setting("rounded", root.rounded ? 0 : 1); }
        else { root.soon(); }
    }

    public pure function matches(value: string, term: string) -> bool {
        return term.is-empty || value.to-lowercase().replace-all(term.to-lowercase(), "") != value.to-lowercase();
    }

    public pure function time(seconds: int) -> string {
        return "\{floor(seconds / 60)}:\{mod(seconds, 60) < 10 ? "0" : ""}\{mod(seconds, 60)}";
    }

    public function select-record(index: int) {
        if (root.record-phase > 0) { return; }
        if (root.discovery-index != index) { root.discovery-index = index; return; }
        root.pending-record = root.placed-record == index ? -1 : index;
        if (!root.motion) {
            root.finish-record();
        } else if (root.placed-record >= 0) {
            root.record-phase = 3;
        } else {
            root.record-phase = 1;
        }
    }

    public function finish-record() {
        root.placed-record = root.pending-record;
        if (root.placed-record >= 0) { root.play(AppBridge.trending[root.placed-record].id); }
        root.record-phase = 0;
    }
}
