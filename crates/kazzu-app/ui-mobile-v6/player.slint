import { SearchField } from "browse.slint";
import { ScrollView } from "std-widgets.slint";
import { AppBridge } from "app-bridge.slint";
import { UI, Screen, Sheet } from "state.slint";
import { Ink, Icon, Glass, Action, Pill, Artwork, Row, Scrubber, Vinyl } from "components.slint";

component MiniDrag inherits TouchArea {
    callback pull(length);
    callback finish(bool);
    callback tapped;
    private property <length> origin-x;
    private property <length> origin-y;
    pointer-event(event) => {
        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
            root.origin-x = self.mouse-x;
            root.origin-y = self.mouse-y;
        } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
            let dx = self.mouse-x - root.origin-x;
            let dy = self.mouse-y - root.origin-y;
            root.finish(dy >= 34px && dy > abs(dx));
            if (abs(dx) < 8px && abs(dy) < 8px && self.has-hover) { root.tapped(); }
        } else if (event.kind == PointerEventKind.cancel) {
            root.finish(false);
        }
    }

    moved => {
        if (self.pressed) {
            let dy = self.mouse-y - root.origin-y;
            let dx = self.mouse-x - root.origin-x;
            root.pull(dy > 8px && dy > abs(dx) ? dy - 8px : 0px);
        }
    }
}

export component BottomIsland inherits Rectangle {
    in property <length> bottom-inset;
    in property <length> left-inset;
    in property <length> right-inset;
    in property <bool> shared-cover;
    private property <length> cover-inset: 10px;
    private property <length> mini-offset: 31px;
    out property <length> cover-x: (self.width - self.inner-width + self.left-inset - self.right-inset) / 2 + self.cover-inset;
    out property <length> cover-y: self.mini-offset + 11px;
    property <length> inner-width: min(550px, self.width - left-inset - right-inset - 20px);
    height: 146px + root.bottom-inset;
    private property <length> drag-offset;
    private property <bool> pulling;

    Rectangle {
        x: (parent.width - root.inner-width + root.left-inset - root.right-inset) / 2;
        y: root.mini-offset;
        width: root.inner-width;
        height: 64px;
        clip: true;
        mini := Glass {
            x: 0;
            y: UI.mini-hidden ? parent.height : root.drag-offset;
            height: parent.height;
            visible: AppBridge.has-now && self.y < parent.height;
            animate y { duration: UI.motion && !root.pulling ? 220ms : 0ms; easing: ease-out; }
            radius: UI.rounded ? 30px : 20px;

            property <bool> wide: self.width >= 470px;
            property <length> outer-padding: root.cover-inset;
            property <length> control-width: self.wide || self.width >= 350px ? 48px : clamp(36px, self.width / 7.5, 44px);
            property <length> transport-width: self.control-width * 3;
            property <length> transport-x: self.wide ? (self.width - self.transport-width) / 2 : self.width - self.outer-padding - self.transport-width;
            property <length> like-x: self.wide ? self.width - self.outer-padding - self.control-width : self.transport-x - self.control-width;
            property <length> info-end: self.wide ? self.transport-x : self.like-x;

            Rectangle {
                x: 0;
                width: info-end;
                height: parent.height;
                accessible-role: button;
                accessible-label: "Abrir player — " + UI.track.title;
                accessible-action-default => { UI.player-open = true; }

                Artwork {
                    x: root.cover-inset; width: 42px; height: 42px;
                    art: UI.track.cover; border-radius: 12px; visible: !root.shared-cover;
                }
                VerticalLayout {
                    x: root.cover-inset + 52px;
                    width: max(0px, parent.width - self.x - 8px);
                    spacing: 2px;
                    alignment: center;
                    Ink { text: UI.track.title; font-weight: 800; }
                    Ink { text: UI.track.artist; color: UI.palette.muted; font-size: 12px; }
                }
            }

            Action {
                x: like-x; width: control-width; size: 36px;
                glyph: UI.liked ? @image-url("assets/heart-filled.svg") : @image-url("assets/heart.svg");
                ink: UI.liked ? UI.palette.accent : UI.palette.ink;
                title: UI.liked ? "Descurtir" : "Curtir";
                activated => { AppBridge.toggle-like(UI.track.id); }
            }
            HorizontalLayout {
                x: transport-x; y: (parent.height - self.height) / 2;
                width: transport-width; height: 48px;
                Action {
                    width: control-width; size: 36px; glyph-size: 18px;
                    glyph: @image-url("assets/prev.svg"); title: "Anterior";
                    activated => { UI.previous(); }
                }
                Action {
                    width: control-width; size: 36px;
                    fill: UI.palette.ink.with-alpha(0.12);
                    glyph: UI.playing ? @image-url("assets/pause.svg") : @image-url("assets/play.svg");
                    title: UI.playing ? "Pausar" : "Tocar";
                    activated => { AppBridge.toggle-play(); }
                }
                Action {
                    width: control-width; size: 36px; glyph-size: 18px;
                    glyph: @image-url("assets/next.svg"); title: "Próxima";
                    activated => { UI.next(); }
                }
            }
            Rectangle {
                x: 24px; y: parent.height - 4px; width: parent.width - 48px; height: 2px;
                border-radius: 1px; background: UI.palette.ink.with-alpha(0.11);
                Rectangle { x: 0; width: parent.width * UI.progress; background: UI.palette.accent; border-radius: 1px; }
            }
        }

        MiniDrag {
            x: 0;
            width: mini.info-end;
            enabled: AppBridge.has-now && !UI.mini-hidden;
            pull(distance) => {
                root.pulling = true;
                root.drag-offset = min(parent.height, distance);
            }
            finish(dismiss) => {
                root.pulling = false;
                root.drag-offset = 0px;
                if (dismiss) { UI.mini-hidden = true; }
            }
            tapped => { UI.player-open = true; }
        }
    }
    Rectangle {
        property <length> search-size: 50px;
        property <length> gap: 14px;
        x: (parent.width - self.width + root.left-inset - root.right-inset) / 2;
        y: 96px;
        width: min(root.inner-width, 264px);
        height: 56px;

        Glass {
            x: 0;
            width: parent.width - parent.search-size - parent.gap;
            height: 50px;
            radius: self.height / 2;
            property <int> selected: UI.screen == Screen.home ? 0 : UI.screen == Screen.explore ? 1 : UI.screen == Screen.library ? 2 : -1;

            Rectangle {
                x: 7px + max(0, selected) * (parent.width - 14px) / 3;
                width: (parent.width - 14px) / 3;
                height: 38px;
                border-radius: self.height / 2;
                opacity: selected >= 0 ? 1 : 0;
                background: @linear-gradient(160deg, #ffffff39, #ffffff0e);
                border-width: 1px;
                border-color: #ffffff34;
                animate x, opacity { duration: UI.motion ? 380ms : 0ms; easing: ease-out; }
            }
            HorizontalLayout {
                padding-left: 7px;
                padding-right: 7px;
                for name[i] in ["Início", "Explorar", "Biblioteca"] : Rectangle {
                    horizontal-stretch: 1;
                    accessible-role: button;
                    accessible-label: name;
                    accessible-action-default => { UI.navigate([Screen.home, Screen.explore, Screen.library][i], 0); }
                    Icon {
                        width: 23px;
                        height: self.width;
                        source: i == 0 && selected == 0 ? @image-url("assets/dock-home-active.svg")
                            : [@image-url("assets/home.svg"), @image-url("assets/compass.svg"), @image-url("assets/dock-library.svg")][i];
                        tint: i == selected ? UI.palette.ink : UI.palette.muted;
                    }
                    TouchArea { clicked => { UI.navigate([Screen.home, Screen.explore, Screen.library][i], 0); } }
                }
            }
        }

        Glass {
            x: parent.width - self.width;
            width: parent.search-size;
            height: self.width;
            radius: self.width / 2;
            property <bool> selected: UI.screen == Screen.search;
            tint: self.selected ? UI.palette.secondary : UI.palette.accent;
            background: UI.battery ? UI.palette.selected
                : self.tint.with-alpha(UI.dark ? (self.selected ? 0.60 : 0.42) : (self.selected ? 0.30 : 0.20));
            Action {
                width: parent.width;
                height: parent.height;
                size: parent.width;
                glyph-size: 24px;
                glyph: @image-url("assets/search.svg");
                title: "Pesquisa";
                ink: UI.dark ? white : UI.palette.accent;
                activated => { UI.navigate(Screen.search, 0); }
            }
        }
    }
}

component Needle inherits Rectangle {
    in property <angle> placement;
    in property <angle> advance;
    Rectangle {
        x: parent.width * 0.90 - self.width / 2;
        y: parent.height * 0.11 - self.height / 2;
        width: parent.width * 0.50;
        height: 22px;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        // Put the pivot at the right tip by offsetting the tube within the rotating bounds.
        Rectangle {
            x: -parent.width * 0.47;
            width: parent.width * 1.03;
            height: 6px;
            background: @linear-gradient(0deg, #54545e, #f2f1f5, #81818a);
            border-radius: 3px;
        }
        Rectangle {
            x: -parent.width * 0.55;
            width: 19px;
            height: 12px;
            background: @linear-gradient(0deg, #1b1b22, #71717d);
            border-radius: 3px;
            Rectangle { x: 1px; y: 2px; width: 3px; height: 3px; border-radius: 2px; background: #eee; }
        }
        Rectangle {
            x: parent.width * 0.54;
            width: 19px;
            height: 15px;
            border-radius: 4px;
            background: @linear-gradient(0deg, #35353c, #a9a9b1, #44444d);
        }
        property <angle> base-angle: root.placement;
        transform-rotation: self.base-angle + root.advance;
        animate base-angle { duration: 1400ms; easing: cubic-bezier(0.45, 0.05, 0.25, 1); }
    }
    Rectangle {
        x: parent.width * 0.90 - self.width / 2;
        y: parent.height * 0.11 - self.height / 2;
        width: 30px;
        height: 30px;
        border-radius: 15px;
        border-width: 1px; border-color: #ffffff64;
        background: @linear-gradient(126deg, #f5f3fa, #666670, #303037, #c5c5cf);
        Rectangle { width: 16px; height: 16px; border-radius: 8px; background: @linear-gradient(40deg, #797983, #bbbcc5, #3c3c44); }
    }
}

component LyricsCard inherits Rectangle {
    in property <length> radius;
    private property <int> count: UI.track.lyrics.length;
    private property <bool> timed: root.count > 0 && UI.track.lyric-times.length == root.count;
    private property <int> active-line;
    private property <string> track-id: UI.track.id;
    changed track-id => { self.active-line = 0; }
    border-radius: root.radius;
    background: UI.palette.card;
    clip: true;

    Rectangle {
        x: 13px; y: 36px; width: parent.width - 26px; height: parent.height - 44px; clip: true;
        if root.count == 0 && AppBridge.lyrics-text.is-empty : Ink {
            width: parent.width;
            text: AppBridge.lyrics-loading ? "Buscando letra…" :
                (AppBridge.lyrics-attribution.is-empty ? "Letra não cadastrada para esta música" : AppBridge.lyrics-attribution);
            color: UI.palette.muted; font-size: 18px; font-weight: 700;
            wrap: word-wrap; overflow: clip; horizontal-alignment: center;
        }
        if !AppBridge.lyrics-text.is-empty : ScrollView {
            width: parent.width; height: parent.height; horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                spacing: 6px;
                Ink { text: AppBridge.lyrics-text; wrap: word-wrap; overflow: clip; }
                Ink { text: AppBridge.lyrics-attribution; color: UI.palette.muted; wrap: word-wrap; }
            }
        }
        for line[index] in UI.track.lyrics : Rectangle {
            property <bool> active: root.timed
                ? (index == 0 || AppBridge.position-ms >= UI.track.lyric-times[index])
                    && (index == root.count - 1 || AppBridge.position-ms < UI.track.lyric-times[index + 1])
                : index == 0;
            changed active => { if (self.active) { root.active-line = index; } }
            y: (parent.height - self.height) / 2 + (index - root.active-line) * 53px;
            height: 53px;
            opacity: self.active ? 1 : (abs(index - root.active-line) < 2 ? 0.36 : 0.22);
            transform-scale: self.active ? 1 : 0.94;
            animate y, opacity, transform-scale { duration: UI.motion ? 300ms : 0ms; easing: ease-out; }
            Ink {
                text: line; font-size: 22px; font-weight: active ? 800 : 700;
                color: active ? UI.palette.ink : UI.palette.muted;
                vertical-alignment: center; horizontal-alignment: center; wrap: word-wrap;
            }
            TouchArea { enabled: root.timed; clicked => { AppBridge.seek(UI.track.lyric-times[index] / max(1, UI.track.duration * 1000)); } }
        }
    }
    Rectangle {
        x: 0; y: 0; height: 36px; background: UI.palette.card;
        Ink { x: 14px; text: "LETRA"; color: UI.palette.accent; font-size: 12px; letter-spacing: 1.4px; font-weight: 800; vertical-alignment: center; }
    }
    Action {
        x: parent.width - 48px; y: 0px;
        glyph: @image-url("assets/close.svg"); title: "Voltar à capa";
        activated => { UI.lyrics = false; }
    }
}

component Stage inherits Rectangle {
    in property <bool> shared-cover;
    in property <length> cover-radius: UI.card-radius;
    private property <length> cover-size: UI.vinyl-mode == 1 ? self.width * 0.66 : self.width;
    private property <float> progress: UI.progress;
    animate progress { duration: 1100ms; easing: linear; }

    Rectangle {
        opacity: UI.lyrics ? 0 : 1;
        visible: self.opacity > 0;
        animate opacity { duration: UI.motion ? 300ms : 0ms; easing: ease-out; }
        if UI.vinyl-mode < 2 : Vinyl {
            x: UI.vinyl-mode == 0 ? 0px : parent.width - self.width - (UI.playing ? 0px : parent.width * 0.06);
            width: parent.width * (UI.vinyl-mode == 0 ? 0.86 : 0.66);
            height: self.width;
            art: UI.track.cover; turns: UI.spin;
            animate x { duration: UI.motion ? 700ms : 0ms; easing: cubic-bezier(0.24, 1.1, 0.45, 1); }
        }
        if UI.vinyl-mode > 0 : Artwork {
            x: 0;
            width: root.cover-size;
            height: self.width;
            art: UI.track.cover;
            visible: !root.shared-cover;
            border-radius: root.cover-radius;
            Rectangle {
                x: 9px; y: parent.height - 34px;
                width: min(album.preferred-width + 16px, parent.width - 18px);
                height: 25px; border-radius: 13px;
                background: #00000099;
                album := Ink { x: 7px; width: parent.width - 14px; text: UI.track.album; color: white; font-size: 13px; font-weight: 750; vertical-alignment: center; }
            }
        }
        if UI.vinyl-mode == 0 : Needle {
            placement: UI.playing ? -28deg : -66deg;
            advance: UI.playing ? -root.progress * 22deg : 0deg;
        }
        TouchArea { enabled: !UI.lyrics; clicked => { UI.lyrics = true; AppBridge.lyrics-request(); } }
        accessible-role: button;
        accessible-label: "Mostrar letra";
        accessible-action-default => { UI.lyrics = true; AppBridge.lyrics-request(); }
    }
    LyricsCard {
        radius: root.cover-radius;
        opacity: UI.lyrics ? 1 : 0;
        visible: self.opacity > 0;
        transform-scale: UI.lyrics || !UI.motion ? 1 : 0.95;
        animate opacity, transform-scale { duration: UI.motion ? 300ms : 0ms; easing: ease-out; }
    }
}

export component Player inherits Rectangle {
    in property <length> top-inset;
    in property <length> bottom-inset;
    in property <length> left-inset;
    in property <length> right-inset;
    in property <bool> shared-cover;
    out property <length> cover-x: (root.width - root.stage-size + root.left-inset - root.right-inset) / 2;
    out property <length> cover-y: root.top-inset + 6px + stage-slot.y + (root.stage-size - root.cover-size) / 2;
    out property <length> cover-size: UI.vinyl-mode == 1 ? root.stage-size * 0.66 : root.stage-size;
    private property <length> usable: root.height - root.top-inset - root.bottom-inset;
    private property <bool> small: root.usable < 660px;
    private property <bool> compact: root.usable < 760px;
    private property <length> controls-height: root.small ? 173px : (root.compact ? 187px : 205px);
    private property <length> waveform-height: root.small ? 28px : (root.compact ? 34px : 40px);
    private property <length> tool-height: root.small ? 32px : (root.compact ? 35px : 38px);
    private property <length> play-size: root.small ? 42px : (root.compact ? 46px : 50px);
    private property <length> play-row: max(48px, root.play-size + 4px);
    private property <length> stage-size: max(110px, min(root.width - root.left-inset - root.right-inset - 36px, root.usable - root.controls-height - 130px, 440px));
    background: UI.dark ? UI.track.tint : UI.palette.player;
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;

    if !UI.battery : Rectangle {
        background: @radial-gradient(circle, UI.track.art.with-alpha(UI.dark ? 0.34 : 0.20), transparent 68%);
    }
    if !UI.battery : Image {
        x: root.cover-x + (root.stage-size - self.width) / 2;
        y: root.top-inset + 6px + stage-slot.y + (root.stage-size - self.height) / 2;
        width: root.stage-size * 1.65; height: self.width;
        opacity: UI.effects == 2 && UI.motion && UI.playing ? 0.70 + sin(animation-tick() / 1s * 80deg) * 0.14 : 0.64;
        image-fit: contain; source: UI.track.glow;
    }
    VerticalLayout {
        x: root.left-inset + 10px; y: root.top-inset + 6px;
        width: root.width - root.left-inset - root.right-inset - 20px;
        height: root.usable - 16px;
        spacing: 2px;
        HorizontalLayout {
            height: 48px;
            Action {
                glyph: @image-url("assets/down.svg"); title: "Recolher player"; fill: UI.palette.ink.with-alpha(0.09);
                activated => { UI.player-open = false; }
            }
            Rectangle { horizontal-stretch: 1; }
            Glass {
                width: 182px; height: 38px; radius: 20px;
                HorizontalLayout {
                    padding: 3px; spacing: 2px;
                    Pill { title: "Áudio"; glyph: @image-url("assets/headphones.svg"); selected: true; inverse: true; horizontal-stretch: 1; }
                    Pill { title: "Vídeo"; glyph: @image-url("assets/video.svg"); horizontal-stretch: 1; activated => { AppBridge.watch-now(); } }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle { width: 48px; }
        }
        Rectangle { vertical-stretch: 1; }
        stage-slot := Rectangle {
            height: root.stage-size;
            Stage { width: root.stage-size; height: self.width; shared-cover: root.shared-cover; }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            height: 58px; padding-left: 10px; padding-right: 3px;
            VerticalLayout {
                horizontal-stretch: 1; alignment: center; spacing: 1px;
                Ink { text: UI.track.title; font-size: root.small ? 24px : 27px; font-weight: 800; letter-spacing: -0.8px; }
                Ink { text: UI.track.artist; font-size: root.small ? 13px : 14px; color: UI.palette.muted; }
            }
            Action {
                title: "Compartilhar"; glyph: @image-url("assets/share.svg"); fill: UI.palette.ink.with-alpha(0.10);
                activated => { AppBridge.share-now(); }
            }
            Action {
                title: UI.liked ? "Descurtir" : "Curtir";
                radius: 12px; glyph: UI.liked ? @image-url("assets/heart-filled.svg") : @image-url("assets/heart.svg");
                ink: UI.liked ? UI.palette.bg : UI.palette.ink;
                fill: UI.liked ? UI.palette.ink : UI.palette.ink.with-alpha(0.10);
                activated => { AppBridge.toggle-like(UI.track.id); }
            }
        }
        Glass {
            height: root.controls-height;
            radius: UI.rounded ? 38px : 20px;
            VerticalLayout {
                padding-left: 13px; padding-right: 13px; padding-top: 7px; padding-bottom: 7px;
                spacing: 1px;
                Scrubber {
                    height: root.waveform-height; waveform: true;
                    label: "Progresso da faixa"; value: UI.progress;
                    changed(fraction) => { if (AppBridge.seekable) { AppBridge.seek(fraction); } }
                }
                HorizontalLayout {
                    height: 16px;
                    Ink { text: AppBridge.position; color: UI.palette.muted; font-size: 12px; horizontal-stretch: 1; }
                    Ink { text: AppBridge.remaining; color: UI.palette.muted; font-size: 12px; }
                }
                HorizontalLayout {
                    height: root.play-row;
                    alignment: space-around;
                    Action {
                        glyph: @image-url("assets/shuffle.svg"); title: "Modo aleatório";
                        ink: UI.shuffle ? UI.palette.secondary : UI.palette.ink;
                        activated => { AppBridge.toggle-shuffle(); }
                    }
                    Action { glyph: @image-url("assets/prev.svg"); title: "Anterior"; activated => { UI.previous(); } }
                    Action {
                        width: max(48px, root.play-size); height: root.play-row; size: root.play-size;
                        glyph: UI.playing ? @image-url("assets/pause.svg") : @image-url("assets/play.svg");
                        title: UI.playing ? "Pausar" : "Tocar";
                        fill: UI.palette.ink; ink: UI.palette.bg; glyph-size: 22px;
                        activated => { AppBridge.toggle-play(); }
                    }
                    Action { glyph: @image-url("assets/next.svg"); title: "Próxima"; activated => { UI.next(); } }
                    Action {
                        glyph: @image-url("assets/repeat.svg"); title: "Repetir";
                        ink: UI.repeat ? UI.palette.secondary : UI.palette.ink;
                        activated => { AppBridge.cycle-repeat(); }
                    }
                }
                HorizontalLayout {
                    height: root.small ? 26px : 33px;
                    spacing: 7px;
                    Icon { width: 18px; height: 16px; source: @image-url("assets/volumeLow.svg"); tint: UI.palette.muted; }
                    Scrubber {
                        label: "Volume"; value: UI.volume;
                        tint: UI.palette.ink; horizontal-stretch: 1;
                        changed(fraction) => { AppBridge.set-volume(fraction); }
                    }
                    Icon { width: 18px; height: 16px; source: @image-url("assets/volumeHigh.svg"); tint: UI.palette.muted; }
                }
                HorizontalLayout {
                    height: root.tool-height; spacing: 5px;
                    for tool[i] in ["Fila", "Letra", "Temporizador", "Mais opções", "Saída de áudio"] : Action {
                        width: (parent.width - 20px) / 5;
                        height: root.tool-height; size: root.tool-height;
                        visual-width: self.width; radius: 12px; glyph-size: 17px;
                        fill: i == 1 && UI.lyrics ? UI.palette.selected : UI.palette.ink.with-alpha(0.10);
                        title: tool;
                        glyph: [@image-url("assets/queue.svg"), @image-url("assets/lyrics.svg"), @image-url("assets/timer.svg"), @image-url("assets/more.svg"), @image-url("assets/device.svg")][i];
                        activated => {
                            if (i == 0) { UI.sheet = Sheet.queue; }
                            else if (i == 1) { UI.lyrics = !UI.lyrics; if (UI.lyrics) { AppBridge.lyrics-request(); } }
                            else if (i == 2) { UI.sheet = Sheet.sleep; }
                            else if (i == 3) { UI.sheet = Sheet.more; }
                            else { AppBridge.list-outputs(); UI.sheet = Sheet.outputs; }
                        }
                    }
                }
            }
        }
    }

}

export component PlayerSheet inherits Rectangle {
    in property <length> bottom-inset;
    property <Sheet> content: Sheet.queue;
    private property <length> sheet-height: min(root.height * 0.75, (root.content == Sheet.queue ? root.height * 0.60 : 296px) + root.bottom-inset);
    private property <bool> open: UI.sheet != Sheet.none;
    visible: shade.opacity > 0 || panel.y < self.height;
    private property <Sheet> requested-sheet: UI.sheet;
    changed requested-sheet => { if (root.requested-sheet != Sheet.none) { root.content = root.requested-sheet; } }

    shade := Rectangle {
        background: #00000087;
        opacity: root.open ? 1 : 0;
        animate opacity { duration: UI.motion ? 220ms : 0ms; easing: ease-out; }
        TouchArea { enabled: root.open; clicked => { UI.sheet = Sheet.none; } }
    }
    panel := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (root.open ? parent.height - self.height : parent.height + 10px) + (drag.pressed ? max(0px, drag.mouse-y - drag.start) : 0px);
        width: min(580px, parent.width);
        height: root.sheet-height;
        border-top-left-radius: UI.card-radius; border-top-right-radius: UI.card-radius;
        border-width: 1px; border-color: UI.palette.ink.with-alpha(0.13);
        background: UI.palette.card;
        animate y { duration: drag.pressed || !UI.motion ? 0ms : 340ms; easing: ease-out; }
        VerticalLayout {
            padding-left: 12px; padding-right: 12px; padding-bottom: root.bottom-inset + 8px;
            spacing: 4px;
            Rectangle {
                height: 55px;
                Rectangle { y: 9px; width: 36px; height: 4px; border-radius: 2px; background: UI.palette.outline; }
                Ink {
                    x: 4px; y: 23px; width: parent.width - 55px; font-size: 18px; font-weight: 800;
                    text: root.content == Sheet.queue ? "Fila de reprodução" : root.content == Sheet.sleep ? "Temporizador" : root.content == Sheet.outputs ? "Saída de áudio" : root.content == Sheet.playlist-create ? "Nova playlist" : root.content == Sheet.playlist-rename ? "Renomear playlist" : root.content == Sheet.playlist-delete ? "Excluir playlist" : root.content == Sheet.playlist-add ? "Adicionar à playlist" : root.content == Sheet.metadata ? "Editar metadados" : "Mais opções";
                }
                Action { x: parent.width - 48px; y: 9px; size: 32px; glyph: @image-url("assets/close.svg"); title: "Fechar"; activated => { UI.sheet = Sheet.none; } }
            }
            if root.content == Sheet.queue : ScrollView {
                vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    spacing: 6px;
                    for track[i] in AppBridge.queue : HorizontalLayout {
                        Row {
                            title: track.title; sub: track.artist; art: track.cover;
                            detail: track.duration-label; chevron: false; horizontal-stretch: 1;
                            activated => { AppBridge.queue-action("jump", AppBridge.queue-ids[i]); UI.sheet = Sheet.none; }
                        }
                        if i > 0 : Action {
                            size: 32px; title: "Mover para cima"; glyph: @image-url("assets/chev.svg");
                            activated => { AppBridge.queue-action("move", AppBridge.queue-ids[i]); }
                        }
                        Action {
                            size: 32px; title: "Remover da fila"; glyph: @image-url("assets/close.svg");
                            activated => { AppBridge.queue-action("remove", AppBridge.queue-ids[i]); }
                        }
                    }
                }
            }
            if root.content == Sheet.sleep : VerticalLayout {
                alignment: start; spacing: 4px;
                for minutes in [0, 15, 30, 60] : Row {
                    title: minutes == 0 ? "Desativar" : "\{minutes} min";
                    checked: AppBridge.sleep-minutes == minutes;
                    activated => { AppBridge.sleep-timer(minutes); UI.sheet = Sheet.none; }
                }
            }
            if root.content == Sheet.outputs : ScrollView {
                vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    Ink { text: AppBridge.output-name; color: UI.palette.muted; }
                    if AppBridge.bit-perfect : Ink { text: "Sem reamostragem ou DSP no motor"; color: UI.palette.muted; }
                    for output in AppBridge.outputs : Row {
                        title: output.title;
                        activated => { AppBridge.select-output(output.id); UI.sheet = Sheet.none; }
                    }
                }
            }
            if root.content == Sheet.playlist-create || root.content == Sheet.playlist-rename : VerticalLayout {
                alignment: start; spacing: 8px;
                SearchField { value <=> UI.playlist-name; hint: "Nome da playlist"; }
                Pill {
                    title: "Salvar";
                    activated => {
                        if (!UI.playlist-name.is-empty) {
                            if (root.content == Sheet.playlist-create) { AppBridge.create-playlist(UI.playlist-name); }
                            else { AppBridge.rename-playlist(UI.playlist-name); }
                            UI.sheet = Sheet.none;
                        }
                    }
                }
            }
            if root.content == Sheet.playlist-delete : VerticalLayout {
                alignment: start; spacing: 8px;
                Ink { text: AppBridge.detail-title; font-weight: 800; }
                Pill { title: "Excluir"; activated => { AppBridge.delete-playlist(); UI.sheet = Sheet.none; } }
            }
            if root.content == Sheet.playlist-add : ScrollView {
                vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    for playlist in AppBridge.playlists : VerticalLayout {
                        if playlist.kind == "playlist" : Row {
                            title: playlist.title; sub: playlist.sub;
                            activated => { AppBridge.add-now-to-playlist(playlist.id); UI.sheet = Sheet.none; }
                        }
                    }
                }
            }
            if root.content == Sheet.metadata : ScrollView {
                vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    spacing: 6px;
                    SearchField { value <=> UI.metadata-title; hint: "Título"; }
                    SearchField { value <=> UI.metadata-artist; hint: "Artista"; }
                    SearchField { value <=> UI.metadata-album; hint: "Álbum"; }
                    SearchField { value <=> UI.metadata-genre; hint: "Gênero"; }
                    Pill {
                        title: "Salvar";
                        activated => {
                            if (!UI.metadata-title.is-empty) {
                                AppBridge.edit-tags(UI.metadata-id, UI.metadata-title, UI.metadata-artist, UI.metadata-album, UI.metadata-genre);
                                UI.sheet = Sheet.none;
                            }
                        }
                    }
                }
            }
            if root.content == Sheet.more : VerticalLayout {
                alignment: start; spacing: 4px;
                Ink { text: "Visual do player"; color: UI.palette.muted; font-size: 13px; }
                Glass {
                    height: 38px; radius: 20px;
                    HorizontalLayout {
                        padding: 3px; spacing: 3px;
                        for label[i] in ["Só disco", "Capa + disco", "Só capa"] : Pill {
                            title: label; selected: UI.vinyl-mode == i; inverse: true; horizontal-stretch: 1;
                            activated => { AppBridge.setting("vinyl", i); }
                        }
                    }
                }
                Row {
                    title: "Adicionar à playlist"; glyph: @image-url("assets/plus.svg");
                    activated => { UI.sheet = Sheet.playlist-add; }
                }
                if AppBridge.has-now && !UI.track.local : Row {
                    title: "Assistir vídeo"; glyph: @image-url("assets/video.svg");
                    activated => { UI.sheet = Sheet.none; AppBridge.watch-now(); }
                }
                Row {
                    title: "Compartilhar música"; glyph: @image-url("assets/share.svg");
                    activated => { UI.sheet = Sheet.none; AppBridge.share-now(); }
                }

            }
        }
        drag := TouchArea {
            property <length> start;
            x: (parent.width - self.width) / 2; y: 0; width: 96px; height: 23px;
            changed pressed => {
                if (self.pressed) { self.start = self.mouse-y; }
                else if (self.mouse-y - self.start > 45px) { UI.sheet = Sheet.none; }
            }
        }
    }
}
