// Dados de demonstração extraídos da referência kazzu 0.5.html.
export struct Track {
    title: string, artist: string, album: string, duration: int,
    tint: color, art: color, cover: image, glow: image, lyrics: [string], lyric-times: [int]
}
export struct Tile { title: string, sub: string, tone: color, glyph: string, cover: image }
export struct Category { title: string, tone: color, track-index: int }
export struct ReplayTrack { title: string, sub: string, plays: int, cover: image }
export struct Scheme { bg: color, player: color, card: color, high: color, ink: color, muted: color, outline: color, accent: color, on-accent: color, secondary: color, selected: color }
export struct SettingRow { title: string, sub: string, detail: string, glyph: image, tag: string, target: int, toggle-index: int, radio-index: int, choice: int, action: string, disabled: bool, kind: string }
export struct SettingPage { title: string, rows: [SettingRow] }
export struct GlassControl { title: string, sub: string, minimum: float, maximum: float, unit: string }

