import { Demo, Track, Scheme } from "data.slint";

export enum Screen { home, explore, library, search, replay, settings, settings-page, appearance }
export enum Sheet { none, queue, more }

struct Route { screen: Screen, page: int }

export global UI {
    in-out property <Screen> screen: Screen.home;
    in-out property <int> page;
    private property <[Route]> history: [];
    in-out property <bool> player-open;
    in-out property <bool> mini-hidden;
    in-out property <Sheet> sheet: Sheet.none;
    in-out property <bool> lyrics;
    in-out property <int> vinyl-mode;
    in-out property <int> track-index;
    out property <Track> track: Demo.tracks[root.track-index];
    in-out property <int> position;
    out property <float> progress: root.position / max(1, root.track.duration);
    in-out property <bool> playing;
    in-out property <bool> shuffle;
    in-out property <bool> repeat;
    in-out property <float> volume: 70;
    private property <float> last-volume: 70;
    in-out property <bool> liked;
    in-out property <int> replay-period: 3;
    in-out property <int> artist-page;
    in-out property <int> suggest-page;
    in-out property <int> discovery-index;
    in-out property <int> placed-record: -1;
    in-out property <int> pending-record: -1;
    in-out property <int> record-phase;
    in-out property <float> spin;
    in-out property <float> platter-spin;
    in-out property <int> search-source;
    in-out property <string> query;
    in-out property <bool> recent: true;
    in-out property <string> settings-query;
    in-out property <string> toast-text;
    in-out property <int> toast-ms;
    in-out property <[bool]> toggles: [true, true, true, true, true, true, true, true, true, true, false, true, true, true, true];
    in-out property <[int]> radios: [0, 0, 0, 2, 1, 0];
    in-out property <[float]> glass: [45, 24, 48, 107, 36];
    out property <bool> dark: root.toggles[1];
    out property <bool> motion: root.toggles[3] && root.radios[4] > 0;
    out property <bool> battery: root.radios[4] == 0;
    out property <Scheme> palette: Demo.schemes[(root.dark ? 0 : 9) + (root.toggles[0] ? root.track-index : 8)];
    out property <length> card-radius: root.toggles[2] ? 28px : 18px;
    out property <length> tile-radius: root.toggles[2] ? 20px : 14px;

    public function navigate(target: Screen, target-page: int) {
        if (root.screen != target || (target == Screen.settings-page && root.page != target-page)) {
            root.history.push({ screen: root.screen, page: root.page });
            root.screen = target;
            root.page = target-page;
        }
    }

    public function back() {
        if (root.sheet != Sheet.none) {
            root.sheet = Sheet.none;
        } else if (root.player-open) {
            root.player-open = false;
        } else if (root.history.length > 0) {
            root.page = root.history[root.history.length - 1].page;
            root.screen = root.history[root.history.length - 1].screen;
            root.history.remove(root.history.length - 1);
        } else {
            root.screen = Screen.home;
        }
    }

    public function play(index: int) {
        root.mini-hidden = false;
        root.start-track(index);
    }

    function start-track(index: int) {
        root.track-index = index;
        root.position = 0;
        root.playing = true;
    }

    public function random-track() {
        // A different demo track on each selection, using the elapsed app time as a seed.
        root.play(root.random-index());
    }

    function random-index() -> int {
        return mod(root.track-index + 1 + mod(floor(animation-tick() / 1ms), Demo.tracks.length - 1), Demo.tracks.length);
    }

    function next-index() -> int {
        return root.shuffle ? root.random-index() : mod(root.track-index + 1, Demo.tracks.length);
    }

    public function next() {
        root.play(root.next-index());
    }

    public function previous() {
        if (root.position > 4) { root.position = 0; }
        else { root.play(mod(root.track-index + Demo.tracks.length - 1, Demo.tracks.length)); }
    }

    public function mute() {
        if (root.volume > 0) { root.last-volume = root.volume; root.volume = 0; }
        else { root.volume = root.last-volume; }
    }

    public function tick() {
        if (root.playing) {
            if (root.position + 1 < root.track.duration) { root.position += 1; }
            else if (root.repeat) { root.position = 0; }
            else { root.start-track(root.next-index()); }
        }
    }

    public function toast(message: string) {
        root.toast-text = message;
        root.toast-ms = 2200;
    }

    public function soon() { root.toast("Em breve nesta versão"); }

    public function clear-search() {
        root.recent = false;
        root.toast("Histórico de buscas apagado");
    }

    public function setting-action(action: string, target: int) {
        if (target == -2) { root.navigate(Screen.appearance, 0); }
        else if (target >= 0) { root.navigate(Screen.settings-page, target); }
        else if (action == "clearSearchHistory") { root.clear-search(); }
        else if (action == "scanLibrary") { root.toast("Biblioteca atualizada: 742 músicas locais"); }
        else if (action == "clearCache") { root.toast("Cache limpo com sucesso"); }
        else { root.soon(); }
    }

    public pure function matches(value: string, term: string) -> bool {
        return term.is-empty || value.to-lowercase().replace-all(term.to-lowercase(), "") != value.to-lowercase();
    }

    public pure function time(seconds: int) -> string {
        return "\{floor(seconds / 60)}:\{mod(seconds, 60) < 10 ? "0" : ""}\{mod(seconds, 60)}";
    }

    public function select-record(index: int) {
        if (root.record-phase > 0) { return; }
        if (root.discovery-index != index) { root.discovery-index = index; return; }
        root.pending-record = root.placed-record == index ? -1 : index;
        if (!root.motion) {
            root.finish-record();
        } else if (root.placed-record >= 0) {
            if (root.track-index == root.placed-record) { root.playing = false; }
            root.record-phase = 3;
        } else {
            root.record-phase = 1;
        }
    }

    public function finish-record() {
        if (root.placed-record != root.pending-record && root.track-index == root.placed-record) { root.playing = false; }
        root.placed-record = root.pending-record;
        if (root.placed-record >= 0) { root.play(root.placed-record); }
        root.record-phase = 0;
    }
}
